Q#include <stdio.h>
#include <stdlib.h>

#define ANNUAL_EXP(salary)  ((salary) * 12)

struct Employee {
    char name[50];
    int id;
    float salary;
};

int main() {

    printf("Size of struct Employee: %zu bytes\n\n", sizeof(struct Employee));

    int n;
    printf("How many employees do you want to insert? ");
    scanf("%d", &n);

    
    struct Employee *emp = (struct Employee*) malloc(n * sizeof(struct Employee));

    if(emp == NULL) {
        printf("Memory allocation failed!\n");
        return 1;
    }


    for(int i = 0; i < n; i++) {
        printf("\n Enter details for Employee %d \n", i + 1);

        getchar();
        printf("Enter Employee Name: ");
        fgets(emp[i].name, 50, stdin);

        printf("Enter Employee ID: ");
        scanf("%d", &emp[i].id);

        printf("Enter Monthly Salary: ");
        scanf("%f", &emp[i].salary);
    }


    printf("\nEmployee Details \n");
    for(int i = 0; i < n; i++) {
        float annual = ANNUAL_EXP(emp[i].salary);

        printf("\nEmployee %d\n", i + 1);
        printf("Name: %s", emp[i].name);
        printf("ID: %d\n", emp[i].id);
        printf("Annual Expenditure: %.2f\n", annual);
    }

    printf("\nTotal Employees Inserted: %d\n", n);

    free(emp);

    return 0;
}
